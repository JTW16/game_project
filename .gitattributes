# 윈도·맥에서 같이 작업할 때 줄바꿈만 다른 파일이 "바뀐 파일"로 뜨지 않게
* text=auto

# 유니티가 쓰는 글자 파일은 항상 LF
*.cs text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.py text eol=lf
*.command text eol=lf

# 윈도 전용은 저장된 그대로
*.bat -text
*.ps1 text eol=crlf
*.slnx -text

*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.ogg binary
*.wav binary
*.mp3 binary
